<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PLPSOFT ERP</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        * {
            pointer-events: auto !important;
        }
        
        body {
            pointer-events: auto;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 260px;
            background: linear-gradient(135deg, #1f3a70 0%, #2a5ec8 100%);
            padding-top: 20px;
            overflow-y: auto;
            box-shadow: 2px 0 8px rgba(0,0,0,0.1);
            z-index: 100;
        }

        .sidebar-item {
            padding: 12px 20px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
            transition: all 0.3s;
            cursor: pointer;
        }

        .sidebar-item:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            cursor: pointer;
        }

        .sidebar-item.active {
            background: rgba(255, 255, 255, 0.15);
            border-left-color: #00d4ff;
            color: white;
            font-weight: 600;
        }

        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                padding: 10px;
                margin-bottom: 20px;
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-item {
                padding: 8px 10px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="px-3 pb-3 mb-3 border-bottom border-light border-opacity-25">
            <a href="/" class="text-white text-decoration-none d-flex align-items-center gap-2">
                <i class="ti ti-shop fs-4"></i>
                <strong>PLPSOFT</strong>
            </a>
        </div>

        <nav class="sidebar-nav">
            <a href="/Promotions/Campaigns" class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="ti ti-discount2"></i>
                <span>Khuyến mãi</span>
            </a>
            <a href="javascript:void(0)" class="sidebar-item" onclick="alert('Báo cáo - Tính năng đang phát triển')">
                <i class="ti ti-report"></i>
                <span>Báo cáo</span>
            </a>
            <a href="javascript:void(0)" class="sidebar-item" onclick="alert('Cài đặt - Tính năng đang phát triển')">
                <i class="ti ti-settings"></i>
                <span>Cài đặt</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #1f3a70 0%, #0066ff 100%); box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 50;">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse ms-auto" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="ti ti-user-circle"></i> Tài khoản
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Page Content -->
        <main class="flex-grow-1 p-4">
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid #dc3545;">
                    <i class="ti ti-alert-circle me-2"></i> <strong>Lỗi:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid #198754;">
                    <i class="ti ti-check me-2"></i> <strong>Thành công:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-3 mt-auto">
            <p class="mb-0">&copy; 2026 PLPSOFT ERP - Module Promotions v1.0</p>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>